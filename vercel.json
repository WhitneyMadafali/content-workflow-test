{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "pip install -r tools/forms-ui/requirements.txt",
  "builds": [
    {
      "src": "tools/forms-ui/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "tools/forms-ui/app.py"
    }
  ]
}
